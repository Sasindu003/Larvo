# Local development API endpoint:
VITE_API_URL=http://localhost:5000/api

# Production notes:
# - Single-Project Vercel Deployment: Leave VITE_API_URL unset or empty.
#   The client will automatically use the relative path '/api', routing to the serverless function.
# - Dual-Project Vercel Deployment: Set VITE_API_URL to your deployed server URL:
#   VITE_API_URL=https://your-server-backend.vercel.app/api
