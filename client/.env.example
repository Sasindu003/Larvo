# API endpoint (defaults to '/api' for same-site security via Vite proxy locally and Vercel rewrites in production):
VITE_API_URL=/api

# Production notes:
# - Recommended (Same-Site): Keep VITE_API_URL=/api.
#   Vercel rewrites /api/* to the server URL (configured in client/vercel.json) allowing SameSite=Lax auth cookies.
# - Dual-Project Cross-Site Fallback: Set VITE_API_URL to your deployed server URL:
#   VITE_API_URL=https://your-server-backend.vercel.app/api
#   (Requires server COOKIE_SAMESITE=none and HTTPS)

# Optional Google OAuth Client ID (for Google Sign-In button on client):
# VITE_GOOGLE_CLIENT_ID=

# Payment Simulator UI Toggle (defaults to true in dev; set to false in production):
VITE_PAYMENT_SIMULATOR_ENABLED=true
