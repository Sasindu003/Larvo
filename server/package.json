{
  "name": "shop-server",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed": "ts-node src/seed/index.ts",
    "seed:categories": "ts-node-dev src/seed/category.seed.ts",
    "seed:products": "ts-node src/seed/product.seed.ts",
    "test": "ts-node src/seed/p11.check.ts",
    "test:p09": "ts-node src/seed/product.check.ts",
    "test:p11": "ts-node src/seed/p11.check.ts",
    "test:p14": "ts-node src/seed/p14.check.ts",
    "test:p31": "ts-node verify_p31.ts",
    "test:all": "ts-node src/seed/product.check.ts && ts-node src/seed/p11.check.ts && ts-node src/seed/p14.check.ts && ts-node verify_p31.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "google-auth-library": "^11.0.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.3.1",
    "multer": "^1.4.5-lts.2",
    "pdfkit": "^0.20.2",
    "slugify": "^1.6.9",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.13",
    "@types/node": "^20.12.11",
    "@types/pdfkit": "^0.17.6",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
