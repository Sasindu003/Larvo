{
  "name": "shop-server",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed": "ts-node src/seed/index.ts",
    "seed:users": "ts-node src/seed/user.seed.ts",
    "seed:categories": "ts-node-dev src/seed/category.seed.ts",
    "seed:products": "ts-node src/seed/product.seed.ts",
    "test": "jest --runInBand",
    "migrate:unset-nulls": "ts-node src/migrations/2026_unset_null_fields.ts",
    "migrate:slip-private": "ts-node src/migrations/2026_payment_slip_private_urls.ts",
    "migrate:encrypt-pii": "ts-node src/migrations/2026_encrypt_personal_fields.ts",
    "migrate:encrypt-pii:apply": "ts-node src/migrations/2026_encrypt_personal_fields.ts --apply",
    "export:local": "node scripts/export-local-json.js",
    "import:local": "node scripts/import-local-json.js",
    "sync:atlas": "node scripts/sync-atlas.js",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --runInBand",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "google-auth-library": "^11.0.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.3.1",
    "multer": "^2.5.0",
    "pdfkit": "^0.20.2",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "slugify": "^1.6.9",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.12.11",
    "@types/pdfkit": "^0.17.7",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.72.1"
  },
  "overrides": {
    "ip-address": "^10.7.4",
    "proxy-addr": "^2.0.8",
    "qs": "^6.16.1"
  }
}
