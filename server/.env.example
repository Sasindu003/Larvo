# Server Port (default: 5000)
PORT=5000

# Node Environment: 'development' | 'production' | 'test' (default: development)
NODE_ENV=development

# MongoDB Connection String
# Local MongoDB:
MONGO_URI=mongodb://localhost:27017/shop
# MongoDB Atlas (Production):
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/<database>?retryWrites=true&w=majority

# JWT Secret: Minimum 32 characters. Do not use placeholder words ('your_', 'change').
# Generate via: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_generate_with_crypto_randomBytes

# JWT Expiration (e.g., '7d', '24h', '1h', default: 7d)
JWT_EXPIRES_IN=7d

# Primary Frontend Client URL (default: http://localhost:5173)
CLIENT_URL=http://localhost:5173

# Client origins allowed for CORS (comma-separated for multiple origins)
CLIENT_ORIGIN=http://localhost:5173
# For Vercel production deployment:
# CLIENT_ORIGIN=http://localhost:5173,https://your-frontend.vercel.app

# Auth Cookie SameSite Policy: 'lax' | 'strict' | 'none' (default: lax)
# - 'lax': Recommended default for same-site deployment via client proxy (Vite dev proxy / Vercel rewrite).
# - 'none': Cross-site fallback (requires HTTPS / Secure cookies and X-Requested-With header).
COOKIE_SAMESITE=lax

# Optional Google OAuth Credentials (for Google Identity Services login)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Structured Logging Level: 'fatal' | 'error' | 'warn' | 'info' | 'debug' | 'trace' (default: info)
LOG_LEVEL=info
