{
  "name": "shop-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "build": "npm run build:server && npm run build:client",
    "build:client": "npm run build --workspace=client",
    "build:server": "npm run build --workspace=server"
  },
  "overrides": {
    "ip-address": "^10.7.4",
    "proxy-addr": "^2.0.8",
    "qs": "^6.16.1",
    "brace-expansion": "^1.1.21",
    "source-map-js": "^1.2.2",
    "esbuild": "^0.25.0",
    "vite": {
      "esbuild": "^0.25.0"
    },
    "tailwindcss": {
      "postcss-selector-parser": "^7.1.6"
    },
    "postcss-nested": {
      "postcss-selector-parser": "^7.1.6"
    }
  }
}
